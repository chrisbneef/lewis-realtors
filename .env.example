# Copy to .env for local runs. Never commit the real .env (already gitignored).

# RentCast API key - powers the monthly market-data refresh.
# Free plan allows 50 requests/month; one refresh run costs ~14.
# Read only by scripts/refresh-market-data.mjs, which runs in GitHub Actions,
# NOT on Vercel. In CI this is the repo secret RENTCAST_API_KEY.
RENTCAST_API_KEY=

# --- Lead capture (src/lib/monday.js). Server side only. ---
# Monday.com API token.
MONDAY_API_TOKEN=
# The "CRM*" board that website leads are created on.
MONDAY_BOARD_ID=
# Melissa Shaw's user id. Her saved board view filters on owner, so a lead
# created without this will not appear in the view she actually watches.
MONDAY_OWNER_ID=

# --- Not yet wired (see the TODO in src/pages/api/capture-lead.js) ---
# Turnstile captcha. Until this is added the endpoint is unauthenticated.
# TURNSTILE_SECRET_KEY=