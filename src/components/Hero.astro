---
import site from "../data/site.json";
import BgVideo from "./BgVideo.astro";
import FeatureVideo from "./FeatureVideo.astro";

// Four things about West Linn itself, not about Melissa and not market data.
// Written as facts rather than judgements, matching how the schools section
// below already handles this: it names the district and documents each
// neighborhood's school path instead of rating anything.
//
// A public-safety point was requested and is deliberately absent. Safety and
// crime framing is the one claim a licensed broker cannot make about an area
// (CLAUDE.md's Fair Housing rule, and PRODUCT.md lists it as a design
// constraint), because it functions as a proxy for protected characteristics.
// Commute stands in its place; see the note to Chris rather than restoring it
// without a decision.
const heroPoints = [
  "West Linn-Wilsonville schools",
  "Historic Willamette Main Street",
  "Two rivers, parks, and trails",
  "25 minutes to Portland",
];
---

<section class="hero">
  <BgVideo
    src="/assets/video/hero-westlinn.mp4"
    srcMobile="/assets/video/hero-westlinn-720.mp4"
    poster="/assets/video/hero-westlinn.jpg"
    class="hero-media"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow" data-reveal>West Linn, Oregon</p>
    <h1 data-reveal style="--reveal-delay: 80ms">
      Know the
      <span class="script">neighborhood</span>
      before you know the home.
    </h1>
    <p class="hero-lead measure" data-reveal style="--reveal-delay: 180ms">
      Know the schools, what homes actually sell for, and what it's really like to live
      there. Every West Linn neighborhood gets its own free monthly market report.
    </p>

    <!-- DOM order puts the video directly under the lead, so on a phone it lands in
         the first screen as intended. On desktop it is placed into the right column
         explicitly, so reading order and visual order can differ without a hack. -->
    <figure class="hero-figure" data-reveal style="--reveal-delay: 220ms">
      <div class="hero-card">
        <figcaption class="hero-video-head">
          <h2 class="hero-video-title">Discover Life in West Linn</h2>
          <p class="hero-video-lead">
            Get a local perspective on the lifestyle, community, and character that
            make West Linn feel like home.
          </p>
        </figcaption>
        <FeatureVideo
          src="/assets/video/discover-west-linn.mp4"
          poster="/assets/video/discover-west-linn.jpg"
          label="Watch: life in West Linn"
        />
      </div>
    </figure>

    <div class="hero-actions" data-reveal style="--reveal-delay: 280ms">
      <a class="btn btn--gold btn--lg" href="#market-report">Get your market report</a>
      <a class="btn btn--ghost btn--lg" href="/home-value">What is my home worth?</a>
      <a class="btn btn--ghost btn--lg" href={site.teamSite.homeSearch} target="_blank" rel="noopener noreferrer">Start my home search</a>
    </div>

    <ul class="hero-points" role="list" data-reveal style="--reveal-delay: 380ms">
      {heroPoints.map((point) => (
        <li class="hero-point">{point}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* fill one screen below the sticky header so the whole hero is above the fold */
    min-height: calc(100svh - 98px);
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 0.5rem + 2.5vw, 2.75rem);
    overflow: hidden;
  }
  /* darken the video toward the copy side so light text stays legible and the
     white agent card pops */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(94deg, rgba(8,8,8,0.82) 0%, rgba(8,8,8,0.56) 44%, rgba(8,8,8,0.14) 100%),
      linear-gradient(0deg, rgba(8,8,8,0.45) 0%, transparent 42%);
  }
  .hero-inner {
    position: relative;
    width: 100%;
    color: var(--ink-onDark);
    display: grid;
    /* Copy stacks in column one; the video spans the full height of column two.
       Explicit placement lets DOM order stay phone-correct. */
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-rows: auto auto auto auto auto;
    align-content: center;
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .hero-eyebrow { grid-column: 1; grid-row: 1; color: var(--gold-bright); }
  .hero h1      { grid-column: 1; grid-row: 2; }
  .hero-lead    { grid-column: 1; grid-row: 3; }
  .hero-actions { grid-column: 1; grid-row: 4; }
  .hero-points  { grid-column: 1; grid-row: 5; }
  .hero-figure  { grid-column: 2; grid-row: 1 / -1; align-self: center; }
  .hero h1 {
    margin-block: 1rem 0;
    font-size: clamp(2.8rem, 1.7rem + 4vw, 5rem);
    color: var(--ink-onDark);
    text-shadow: 0 1px 30px rgba(0, 0, 0, 0.35);
  }
  .hero h1 .script {
    display: inline-block;
    font-size: 1.15em;
    line-height: 0.85;
    padding-inline: 0.06em;
  }
  .hero-lead {
    margin-top: 1.3rem;
    font-size: var(--fs-lead);
    color: var(--ink-onDark-soft);
    font-weight: 300;
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.3);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }
  /* Three CTAs: the gold report button takes the full first row, the two
     secondary actions pair up beneath it. */
  .hero-actions .btn {
    flex: 1 1 220px;
    padding-inline: 1.2em;
    letter-spacing: 0.1em;
  }
  .hero-actions .btn--gold { flex-basis: 100%; }
  .hero-actions .btn--ghost { color: var(--ink-onDark); border-color: var(--line-onDark); }

  /* Wider than the old portrait card: this column now holds a 16:9 video. */
  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-top: 1.7rem;
    border-top: 1px solid var(--line-onDark);
    max-width: 34rem;
    list-style: none;
    padding-inline: 0;
  }
  /* Self-contained rather than extending the global .pill: that class sets a
     border shorthand and its own colour, and depending on it made these
     render as bare text whenever its rules won the cascade. */
  .hero-point {
    display: inline-flex;
    align-items: center;
    padding: 0.45em 0.9em;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--gold-bright);
    background: rgba(10, 10, 10, 0.34);
    border: 1px solid color-mix(in srgb, var(--gold) 62%, transparent);
    border-radius: 100px;
  }

  .hero-figure { position: relative; margin: 0; justify-self: end; width: 100%; max-width: 540px; }
  /* Media panel: the one place the system's resting shadow is correct. */
  .hero-card {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.1rem;
    box-shadow: var(--shadow-lg);
  }
  .hero-card :global(.fvideo) {
    border-radius: var(--radius);
    box-shadow: none;
  }
  /* Inside the card the head sits on paper, so it takes the ink ramp. */
  .hero-video-head { padding: 0.35rem 0.45rem 1rem; }
  .hero-video-title {
    font-size: clamp(1.55rem, 1.35rem + 0.7vw, 1.9rem);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .hero-video-lead {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-block: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    }
    .hero-inner { grid-template-columns: 1fr; grid-template-rows: none; }
    .hero-eyebrow, .hero h1, .hero-lead, .hero-actions, .hero-points, .hero-figure {
      grid-column: 1;
      grid-row: auto;
    }
    .hero-figure { justify-self: stretch; margin-top: 1.9rem; max-width: none; }
    .hero-actions { margin-top: 1.9rem; }
  }

  /* Desktop viewports shorter than the hero's natural height: compress so it
     still clears the fold. The threshold has to cover ordinary laptop windows
     (roughly 800-1000px of viewport), not just unusually short ones, because
     three CTA buttons plus the video block push the natural height past
     1000px. */
  @media (min-width: 901px) and (max-height: 1040px) {
    .hero h1 { font-size: clamp(2.1rem, 1.4rem + 2.4vw, 3.4rem); }
    .hero-lead { margin-top: 0.9rem; font-size: 1.05rem; }
    .hero-actions { margin-top: 1.3rem; gap: 0.7rem; }
    .hero-figure { max-width: 480px; }
  }
  /* Genuinely short windows need a second, harder step. */
  @media (min-width: 901px) and (max-height: 850px) {
    .hero h1 { font-size: clamp(1.95rem, 1.3rem + 2vw, 2.9rem); }
    .hero-lead { margin-top: 0.7rem; font-size: 1rem; }
    .hero-actions { margin-top: 1rem; }
    .hero-figure { max-width: 420px; }
  }
</style>
