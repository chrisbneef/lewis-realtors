---
// What West Linn homes actually SOLD for, from Melissa's monthly RMLS pull
// (src/data/rmls-sold.json). These are closed sale figures, not asking prices,
// and they are city-wide: detached residential only. The per-neighborhood
// asking-price data in market.json is a separate dataset and is labelled as
// asking wherever it appears.
import { latestSold, rmlsSold } from "../lib/market.js";

const m = latestSold();
const money = (n) => (n == null ? null : `$${Math.round(n).toLocaleString()}`);

const stats = m
  ? [
      { value: money(m.sold.medianPrice), label: "Median sold price" },
      { value: String(m.sold.units), label: "Homes sold" },
      { value: String(m.daysOnMarket.median), label: "Median days on market" },
      { value: m.monthsOfInventory.toFixed(1), label: "Months of inventory" },
    ].filter((s) => s.value != null)
  : [];
---

{m && (
  <section class="band section--ink">
    <div class="wrap band-inner">
      <div class="band-intro-wrap" data-reveal>
        <p class="band-intro">
          What West Linn homes actually sold for in {m.label}.
        </p>
        <p class="band-sub">
          Closed sales, not asking prices, from Melissa's monthly RMLS pull.
        </p>
      </div>
      <ul class="band-stats" role="list">
        {stats.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="band-val band-val--market">{s.value}</span>
            <span class="band-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="wrap band-source">{`${rmlsSold.criteria.note} ${rmlsSold.attribution}`}</p>
    <span class="band-glow" aria-hidden="true"></span>
  </section>
)}

<style>
  .band { padding-block: clamp(3rem, 2rem + 3vw, 4.5rem); position: relative; overflow: hidden; }
  .band-glow {
    position: absolute;
    top: 50%; right: -6%;
    width: 38%; height: 220%;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(108,130,165,0.32), transparent 68%);
    pointer-events: none;
    z-index: 0;
  }
  .band-inner { position: relative; z-index: 1; }
  .band-inner { display: grid; grid-template-columns: 0.8fr 2.2fr; gap: 2.5rem; align-items: center; }
  .band-intro {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink-onDark);
    max-width: 26ch;
  }
  .band-sub {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-onDark-soft);
    max-width: 30ch;
  }
  .band-source {
    position: relative;
    z-index: 1;
    margin-top: 2.2rem;
    font-size: 0.68rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--ink-onDark-soft) 72%, transparent);
    max-width: 96ch;
  }
  .band-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .band-val {
    display: block;
    font-family: var(--font-display);
    /* Capped lower than the other stat rows on the site: a full "$854,500"
       overruns its grid column at the larger size. */
    font-size: clamp(1.6rem, 1.15rem + 1.25vw, 2.3rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  /* Thin display strokes read faint in gold on near-black; brighten + a soft
     glow so the placeholder value stays clearly legible on the dark band. */
  .band-val--market { color: #f2e4b0; text-shadow: 0 0 20px rgba(242, 228, 176, 0.35); }
  .band-val--place { color: var(--azure-bright); }
  .band-label {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-onDark-soft);
  }
  .band-label .tag-sample { display: inline-block; margin-top: 0.4rem; }

  @media (max-width: 820px) {
    .band-inner { grid-template-columns: 1fr; gap: 1.8rem; }
    .band-stats { grid-template-columns: repeat(2, 1fr); gap: 1.6rem; }
  }
</style>
