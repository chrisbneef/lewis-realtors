---
const {
  formType = "market-report",
  neighborhood = "west-linn",
  neighborhoodName = "West Linn",
  heading,
  blurb,
  cta = "Send my report",
} = Astro.props;

const isValuation = formType === "valuation";
const isContact = formType === "contact";

const defaultHeading = isValuation
  ? "What is my home worth?"
  : isContact
    ? "Send me a message"
    : `Get the ${neighborhoodName} market report`;
const defaultBlurb = isValuation
  ? "Tell me about your home and I'll build a personalized valuation from real neighborhood sold data, not an automated guess."
  : isContact
    ? "Tell me what you're looking for and the best way to reach you. I'll get back to you personally."
    : `Median asking price, days on market, and what's currently for sale in ${neighborhoodName}, plus the twelve-month West Linn price trend. Refreshed every month from live listing data and sent straight to your inbox.`;

// Unique id prefix so several forms can live on one page without colliding.
const uid = `${formType}-${neighborhood}`;

const roles = [
  { value: "buyer", label: "Buying" },
  { value: "seller", label: "Selling" },
  { value: "both", label: "Both" },
];
---

<form class="lead-form" data-lead-form data-form-type={formType} data-neighborhood={neighborhood}>
  <div class="lead-head">
    <h3 class="lead-title">{heading || defaultHeading}</h3>
    <p class="lead-blurb">{blurb || defaultBlurb}</p>
  </div>

  <div class="lead-grid">
    <div class="field">
      <label for={`first-${uid}`}>First name</label>
      <input class="input" id={`first-${uid}`} name="firstName" type="text" autocomplete="given-name" placeholder="First name" required />
    </div>
    <div class="field">
      <label for={`last-${uid}`}>Last name</label>
      <input class="input" id={`last-${uid}`} name="lastName" type="text" autocomplete="family-name" placeholder="Last name" required />
    </div>
    <div class="field">
      <label for={`email-${uid}`}>Email</label>
      <input class="input" id={`email-${uid}`} name="email" type="email" autocomplete="email" placeholder="you@email.com" required />
    </div>
    <div class="field">
      <label for={`phone-${uid}`}>Phone number</label>
      <input class="input" id={`phone-${uid}`} name="phone" type="tel" autocomplete="tel" placeholder="(503) 555-0123" required />
    </div>
    {isValuation && (
      <div class="field field--full">
        <label for={`address-${uid}`}>Property address</label>
        <input class="input" id={`address-${uid}`} name="address" type="text" autocomplete="street-address" placeholder="Street, West Linn, OR" />
      </div>
    )}
  </div>

  <fieldset class="role-set">
    <legend>What best describes you?</legend>
    <div class="segmented" role="radiogroup">
      {roles.map((r) => (
        <div class="seg">
          <input type="radio" id={`role-${r.value}-${uid}`} name="role" value={r.value} required />
          <label for={`role-${r.value}-${uid}`}>{r.label}</label>
        </div>
      ))}
    </div>
  </fieldset>

  {isContact && (
    <div class="field">
      <label for={`message-${uid}`}>How can I help?</label>
      <textarea
        class="input textarea"
        id={`message-${uid}`}
        name="message"
        rows="4"
        placeholder="Tell me what brought you here and when's a good time to call you back."
        required
      />
    </div>
  )}

  <div class="consent">
    <input type="checkbox" id={`sms-${uid}`} name="smsConsent" value="yes" />
    <label for={`sms-${uid}`}>
      Text me updates. By checking this box I agree to receive text messages from
      Lewis Realtors at the number provided, including messages about my request.
      Consent is not a condition of purchase. Message and data rates may apply.
      Reply STOP to opt out at any time.
    </label>
  </div>

  <!-- CAPTCHA mounts here once Cloudflare Turnstile keys are added (see capture-lead.js TODO). -->
  <div class="captcha-slot" data-captcha aria-hidden="true"></div>

  <button class="btn btn--gold btn--lg lead-submit" type="submit">
    <span class="submit-label">{cta}</span>
    <span class="submit-spin" aria-hidden="true"></span>
  </button>

  <p class="lead-fineprint">
    No spam. Your information goes only to Melissa Shaw at Lewis Realtors.
  </p>

  <div class="lead-status" data-status role="status" aria-live="polite"></div>
</form>

<script>
  document.querySelectorAll("[data-lead-form]").forEach((form) => {
    const status = form.querySelector("[data-status]");
    const btn = form.querySelector(".lead-submit");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.classList.add("is-loading");
      btn.disabled = true;
      status.className = "lead-status";
      status.textContent = "";

      const payload = {
        firstName: form.firstName.value.trim(),
        lastName: form.lastName.value.trim(),
        email: form.email.value.trim(),
        phone: form.phone.value.trim(),
        role: form.querySelector("input[name='role']:checked")?.value || "",
        smsConsent: form.smsConsent.checked,
        message: form.message ? form.message.value.trim() : undefined,
        address: form.address ? form.address.value.trim() : undefined,
        formType: form.dataset.formType,
        neighborhood: form.dataset.neighborhood,
        pageUrl: window.location.href,
        token: form.querySelector("[name='cf-turnstile-response']")?.value || "dev-stub",
      };

      try {
        const res = await fetch("/api/capture-lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          status.className = "lead-status is-ok";
          status.textContent = data.message || "Thank you. Your report is on the way to your inbox.";
        } else {
          throw new Error(data.error || "Something went wrong.");
        }
      } catch (err) {
        status.className = "lead-status is-error";
        status.textContent = "We couldn't send that just now. Please call (503) 489-8367 or try again.";
      } finally {
        btn.classList.remove("is-loading");
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold-deep);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1rem + 2vw, 2.6rem);
    box-shadow: var(--shadow);
  }
  /* The card is always light (even inside a dark section), so pin the heading
     to ink - otherwise the .section--ink h2/h3 rule repaints it near-white. */
  .lead-title { font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.1rem); color: var(--ink); }
  .lead-blurb { margin-top: 0.7rem; color: var(--ink-soft); font-size: 0.95rem; }
  .lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field--full { grid-column: 1 / -1; }
  .captcha-slot:empty { display: none; }

  .textarea {
    min-height: 7.5rem;
    resize: vertical;
    line-height: 1.55;
  }

  /* "What best describes you" - segmented pills */
  .role-set { border: 0; padding: 0; margin: 0; }
  .role-set legend {
    padding: 0;
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .segmented { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .seg { flex: 1 1 auto; min-width: 0; }
  .seg input {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .seg label {
    display: block;
    text-align: center;
    padding: 0.72em 1.2em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .seg label:hover { border-color: var(--gold); color: var(--ink); }
  .seg input:checked + label {
    background: var(--grad-gold);
    border-color: var(--gold-deep);
    color: var(--noir);
  }
  .seg input:focus-visible + label {
    outline: 2px solid var(--azure-deep);
    outline-offset: 2px;
  }

  /* SMS consent */
  .consent { display: flex; align-items: flex-start; gap: 0.65rem; }
  .consent input {
    flex: none;
    width: 18px; height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--gold-deep);
    cursor: pointer;
  }
  .consent label {
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .lead-submit { position: relative; align-self: flex-start; }
  .lead-submit .submit-spin {
    width: 15px; height: 15px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: none;
    animation: spin 0.7s linear infinite;
  }
  .lead-submit.is-loading .submit-label { opacity: 0.6; }
  .lead-submit.is-loading .submit-spin { display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .lead-fineprint { font-size: 0.74rem; color: var(--ink-muted); }
  .lead-status { font-size: 0.9rem; }
  .lead-status.is-ok { color: var(--azure-deep); font-weight: 500; }
  .lead-status.is-error { color: #b23b3b; }

  @media (max-width: 520px) {
    .lead-grid { grid-template-columns: 1fr; }
    .segmented { flex-direction: column; }
  }
</style>
