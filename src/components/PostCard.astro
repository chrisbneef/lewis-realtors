---
// Blog post card for the /blog index. Forked from NeighborhoodCard.
const { post } = Astro.props;
const d = post.data;
const href = `/blog/${post.id}`;
const dt = new Date(d.publishDate);
const dateLabel = dt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const themeLabel = d.theme === "real-estate" ? "Real estate" : "Lifestyle";
---

<a class="post-card card" href={href} data-reveal>
  {d.heroImage && (
    <div class="post-photo">
      <img src={d.heroImage} alt="" loading="lazy" width="704" height="420" />
      <span class="post-scrim" aria-hidden="true"></span>
    </div>
  )}
  <div class="post-body">
    <div class="post-meta-top">
      <span class:list={["pill", d.theme === "real-estate" ? "pill--gold" : "pill--azure"]}>{themeLabel}</span>
      <time datetime={dt.toISOString()}>{dateLabel}</time>
    </div>
    <h3 class="post-title">{d.title}</h3>
    <p class="post-excerpt">{d.description}</p>
    <span class="link post-read">Read <span class="arrow">&rarr;</span></span>
  </div>
</a>

<style>
  .post-card { display: flex; flex-direction: column; overflow: hidden; }
  .post-photo {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cream-deep);
  }
  .post-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .post-card:hover .post-photo img { transform: scale(1.05); }
  .post-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,18,15,0.28) 0%, transparent 40%); pointer-events: none; }
  .post-body { padding: 1.4rem 1.5rem 1.6rem; display: flex; flex-direction: column; gap: 0.7rem; flex-grow: 1; }
  .post-meta-top { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; }
  .post-meta-top time { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  .post-title { font-size: 1.45rem; line-height: var(--leading-snug); }
  .post-excerpt { font-size: 0.92rem; color: var(--ink-soft); flex-grow: 1; }
  .post-read { margin-top: 0.4rem; }
  .post-read::after { display: none; }
  .post-card:hover .post-read .arrow { transform: translateX(5px); }
</style>
