---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import MeetMelissa from "../components/MeetMelissa.astro";
import site from "../data/site.json";
import { realEstateAgent } from "../lib/schema.js";
---

<Base
  title="About"
  description="Meet Melissa Shaw and Team Lewis Realtors: the mission, values, and people behind 23+ years and more than $128 million sold in West Linn, Oregon real estate."
  jsonLd={[realEstateAgent()]}
>
  <PageHero
    crumb="About"
    eyebrow="The office"
    title={`Local knowledge that<br/>works for <span class="script">you</span>.`}
    lead="Lewis Realtors has extensive knowledge of the local market, the pockets, and the neighborhoods, plus the things you truly want to know when buying or selling here, beyond pricing and negotiation."
  />

  <!-- Mission -->
  <section class="section--tight section--ink mission">
    <div class="wrap mission-inner" data-reveal>
      <p class="eyebrow eyebrow--center">Our mission</p>
      <p class="mission-line">
        We help clients live their best lives through real estate:
        <span class="script">building wealth</span>, strengthening communities,
        and creating lasting legacies.
      </p>
    </div>
  </section>

  <MeetMelissa />

  <!-- The team -->
  <section class="section" id="team">
    <div class="wrap">
      <div class="team-head" data-reveal>
        <p class="eyebrow eyebrow--center">Meet the team</p>
        <h2 class="center">The people behind<br/>every <span class="script">move</span>.</h2>
        <p class="team-lead center measure">
          We believe service is non-negotiable, and it takes more than one person to
          deliver it. Behind every Lewis Realtors transaction is a team that treats
          your move like their own.
        </p>
      </div>
      <div class="team-grid">
        {site.team.map((member, i) => (
          <article class="team-card card" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <div class="team-photo">
              <img src={member.photo} alt={`${member.name}, ${member.role}, Lewis Realtors`} loading="lazy" width="360" height="420" />
            </div>
            <div class="team-body">
              <h3 class="team-name">{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <p class="team-bio">{member.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Core values -->
  <section class="section section--cream" id="values">
    <div class="wrap">
      <div class="values-head" data-reveal>
        <p class="eyebrow eyebrow--center">Our core values</p>
        <h2 class="center">What we <span class="script">stand</span> for.</h2>
      </div>
      <ol class="values-list" role="list">
        {site.values.map((v, i) => (
          <li class="value" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="value-num">0{i + 1}</span>
            <h3 class="value-name">{v.name}</h3>
            <p class="value-line">{v.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- How that shows up on this site -->
  <section class="section">
    <div class="wrap about-values">
      <div class="about-val" data-reveal>
        <h3>Your outcome is the goal</h3>
        <p>We're results-oriented, and what fulfills us is fulfilling your needs. We lead with information, not pressure. If a home or a moment isn't right, we say so.</p>
      </div>
      <div class="about-val" data-reveal style="--reveal-delay: 80ms">
        <h3>Real data, never guesses</h3>
        <p>Every number on this site comes from live listing data, refreshed monthly. We don't invent figures to win a listing.</p>
      </div>
      <div class="about-val" data-reveal style="--reveal-delay: 160ms">
        <h3>Relationships over transactions</h3>
        <p>Our business is built on referrals, so we aim to be worth talking about: service that continues before, during, and long after the sale.</p>
      </div>
    </div>
  </section>

  <!-- Giving back: Lewis Loves -->
  <section class="section section--ink" id="lewis-loves">
    <div class="wrap giving">
      <div class="giving-copy" data-reveal>
        <p class="eyebrow">Giving back</p>
        <h2 class="giving-title">Serving others is at the heart<br/>of what we <span class="script">do</span>.</h2>
        <p class="giving-lead">
          Home is more than a place. It's the people, neighborhoods, and shared moments
          that make it special. That's why giving back is built into how we work,
          because helping you make your move happen also means helping our community thrive.
        </p>
      </div>
      <div class="giving-cards">
        <div class="giving-card card" data-reveal style="--reveal-delay: 100ms">
          <h3 class="gc-name">Lewis <span class="script gc-heart">Loves</span> CommUnity</h3>
          <p class="gc-body">
            Our movement dedicated to serving others with compassion, dignity, and the
            connection of truly being seen. Every closing donates five blankets to
            local emergency rooms.
          </p>
        </div>
        <div class="giving-card card" data-reveal style="--reveal-delay: 200ms">
          <h3 class="gc-name">Homes for Heroes&reg;</h3>
          <p class="gc-body">
            Melissa is an affiliate specialist with the national Homes for Heroes
            program, paying it forward to local firefighters, EMS, law enforcement,
            military, healthcare workers, and teachers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond West Linn -->
  <section class="section--tight">
    <div class="wrap">
      <div class="beyond card" data-reveal>
        <div class="beyond-copy">
          <p class="eyebrow">Two states, one standard</p>
          <h2 class="beyond-title">Beyond West Linn</h2>
          <p class="beyond-lead">
            This site is our West Linn home base: {site.agent.designations.join(" and ")},
            with the same care on both sides of the river. For the full team's work
            across {site.teamSite.area}, along with home value tools and homeowner
            checklists, visit our team site.
          </p>
        </div>
        <a class="btn btn--gold" href={site.teamSite.href} target="_blank" rel="noopener noreferrer">
          Visit {site.teamSite.label}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Mission */
  .mission-inner { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; text-align: center; }
  .mission-line {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.6rem);
    line-height: 1.35;
    color: var(--ink-onDark);
    max-width: 26ch;
  }
  .mission-line .script { font-size: 1.15em; color: var(--gold-bright); }

  /* Team */
  .team-head { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-bottom: 3rem; }
  .team-lead { color: var(--ink-soft); font-size: var(--fs-lead); font-weight: 300; }
  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .team-card { display: flex; flex-direction: column; overflow: hidden; }
  .team-photo {
    display: flex; align-items: flex-end; justify-content: center;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(200,160,74,0.25), transparent 60%),
      linear-gradient(180deg, var(--cream-deep), var(--azure) 320%);
  }
  .team-photo img { max-height: 92%; width: auto; max-width: 88%; object-fit: contain; }
  /* Lisa's source photo is a tighter head-and-shoulders crop than the other two,
     so it needs its own scale and a nudge downward to line her face up with the
     rest of the row. */
  .team-card:nth-child(2) .team-photo img { max-height: 88%; transform: translateY(3%); }
  .team-body { padding: 1.6rem 1.6rem 1.8rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .team-name { font-size: 1.6rem; }
  .team-role { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-deep); }
  .team-bio { color: var(--ink-soft); font-size: 0.92rem; margin-top: 0.4rem; }

  /* Values */
  .values-head { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-bottom: 3rem; }
  .values-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.6rem;
  }
  .value { padding-top: 1.4rem; border-top: 2px solid transparent; border-image: var(--grad-gold) 1; }
  .value:nth-child(even) { border-image: var(--grad-azure) 1; }
  .value-num { font-family: var(--font-display); font-size: 0.95rem; color: var(--ink-muted); letter-spacing: 0.2em; }
  .value-name { font-size: 1.25rem; margin-top: 0.6rem; }
  .value-line { color: var(--ink-soft); font-size: 0.88rem; margin-top: 0.5rem; }

  /* Practice blocks (kept from the earlier page) */
  .about-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .about-val { padding-top: 1.6rem; border-top: 2px solid transparent; border-image: var(--grad-gold) 1; }
  .about-val:nth-child(2) { border-image: var(--grad-azure) 1; }
  .about-val h3 { font-size: 1.5rem; }
  .about-val p { color: var(--ink-soft); margin-top: 0.7rem; font-size: 0.95rem; }

  /* Giving back */
  .giving { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  .giving-title { color: var(--ink-onDark); margin-top: 1rem; }
  .giving-lead { color: var(--ink-onDark-soft); margin-top: 1.3rem; max-width: 48ch; }
  .giving-cards { display: flex; flex-direction: column; gap: 1.4rem; }
  .giving-card { padding: 1.8rem; border-top: 3px solid var(--gold-deep); }
  /* Cards are light-on-dark-section: force ink colors so headings don't inherit
     the section's on-dark text color and vanish against the white card. */
  .gc-name { font-size: 1.45rem; color: var(--ink); }
  .gc-heart { color: var(--gold-deep); font-size: 1.2em; padding-inline: 0.08em; }
  .gc-body { color: var(--ink-soft); font-size: 0.92rem; margin-top: 0.7rem; }

  /* Beyond West Linn */
  .beyond {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 3px solid var(--azure-deep);
  }
  .beyond-title { font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem); margin-top: 0.5rem; }
  .beyond-lead { color: var(--ink-soft); margin-top: 0.8rem; max-width: 60ch; }
  /* Long domain label: let the button shrink and wrap on narrow screens instead
     of clipping. */
  .beyond .btn { max-width: 100%; min-width: 0; white-space: normal; text-align: center; line-height: 1.5; }

  @media (max-width: 980px) {
    .values-list { grid-template-columns: repeat(2, 1fr); }
    /* 5 items in 2 columns: let the last value span the full row rather than
       orphan in a half-empty final row. */
    .value:last-child { grid-column: 1 / -1; }
    .giving { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .team-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
  @media (max-width: 820px) {
    .about-values { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 560px) {
    .values-list { grid-template-columns: 1fr; }
  }
</style>
